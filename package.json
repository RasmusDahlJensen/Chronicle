    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
