{
  "name": "chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "nodemon --config nodemon.json --exec node scripts/start.ts",
    "dev": "nodemon --config nodemon.json --exec node scripts/start.ts",
    "build": "vite build",
    "preview": "node scripts/start.ts --preview",
    "serve": "node scripts/start.ts --serve",
    "typecheck": "tsc --noEmit",
    "check:architecture": "biome lint src shared server scripts vendor/platec/runtime.ts",
    "test": "node --test --test-concurrency=4 tests/*.test.ts",
    "check": "npm run check:architecture && npm run check:tectonics && npm run typecheck && npm test && npm run test:browser",
    "test:browser": "npm run build && playwright test",
    "bench:world": "node scripts/bench-world.ts",
    "build:tectonics": "node scripts/build-platec.ts",
    "check:tectonics": "node scripts/build-platec.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "nodemon": "3.1.14",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "piscina": "5.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.30"
  }
}
