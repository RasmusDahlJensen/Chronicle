{
  "name": "chronicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/start.ts",
    "dev": "node scripts/start.ts",
    "build": "vite build",
    "preview": "node scripts/start.ts --preview",
    "serve": "node scripts/start.ts --serve",
    "typecheck": "tsc --noEmit",
    "check:architecture": "biome lint src shared server scripts",
    "test": "node --test tests/*.test.ts",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "bench:backend": "node scripts/bench-backend.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "piscina": "5.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.30"
  }
}
